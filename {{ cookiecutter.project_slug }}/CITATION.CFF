cff-version: 1.2.0
message: "If you use this software, please cite it as below."

{% for author in cookiecutter.authors_info.split("|") %}
{% set parts = author.split(",") %}
author:
- first_name: {{ parts[0] }}
- last_name: {{ parts[1] }}
- ORCID: {{ parts[2] }}
{% endfor %}
title: {{ cookiecutter.project_name }}
version: 1.0
identifiers:
  - type: doi
    value: 
date-released: {{ cookiecutter.date }}
