cff-version: 1.2.0
message: "If you use this software, please cite it as below."

{% for author in cookiecutter.authors_info.split("|") %}
{% set parts = author.split(",") %}
author:
- first_name: {{ parts[0].strip() }}
- last_name: {{ parts[1].strip() }}
{% if parts|length > 2 and parts[2].strip() %}
- ORCID: {{ parts[2].strip() }}
{% endfor %}
title: {{ cookiecutter.method_title }}
version: 1.0
identifiers:
  - type: doi
    value: 
date-released: {{ cookiecutter.release_date }}
